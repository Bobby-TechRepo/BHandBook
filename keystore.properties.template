# Copy to keystore.properties (git-ignored) and fill in. Create a key once with:
#   keytool -genkeypair -v -keystore release.jks -alias bhandbook -keyalg RSA -keysize 4096 -validity 10000
# KEEP release.jks AND ITS PASSWORDS SAFE: if you lose them you can never update the app on Google Play (unless you use Play App Signing and an upload key).
storeFile=release.jks
storePassword=change-me
keyAlias=bhandbook
keyPassword=change-me
